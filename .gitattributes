# Preserve benchmark and model configuration bytes across checkouts.
autolux/training/*.json text eol=lf
autolux/training/nn/*.json text eol=lf
autolux/training/data/raveform/annotations/*.hand.json text eol=lf

# Media must remain byte-identical.
autolux/training/eval_audio/*.mp3 binary

# Keep calibrated program and rig hashes stable across checkouts.
show/autoloops/**/*.lua text eol=lf
rig/library/*.gdtf binary
autolux/tests/data/generic_rig/*.gdtf binary
show/**/*.toml text eol=lf
